###############################################################################
# CafeTrack — gaming cafe management SaaS
###############################################################################

APP_NAME=CafeTrack
APP_ENV=local
# php artisan key:generate. Also the default HMAC key for signed QR tokens.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# All timestamps are stored as naive UTC. Do not change this: the analytics
# heatmap groups by weekday and hour and is wrong if rows are stored mixed.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# Passwords are bcrypt so hashes from the FastAPI reference import unchanged.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL 8, utf8mb4 (customer names and notes contain Bangla text)
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafetrack
DB_USERNAME=cafetrack
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

###############################################################################
# CafeTrack settings
###############################################################################

# Signing key for auth tokens. Falls back to APP_KEY when blank. Set this
# explicitly to the FastAPI reference's SECRET_KEY to run both backends side
# by side during a migration — the claims are identical.
JWT_SECRET=
JWT_TTL_HOURS=12

# Where the public check-in page lives. QR codes encode
# {FRONTEND_BASE_URL}/checkin/{station_id}?t={token}
FRONTEND_BASE_URL=http://localhost:3000

# When true, an anonymous check-in without a valid signed station token is 403.
# Logged-in staff always bypass the check.
REQUIRE_QR_TOKEN=true

# Per-IP sliding one-minute windows. 0 disables a limit entirely.
RATE_LIMIT_CHECKIN=10
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC_STATION=120

# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000

###############################################################################
# Framework plumbing
###############################################################################

# NOT "database": CafeTrack owns the `sessions` table (play sessions), so the
# framework's own session store must live somewhere else.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
